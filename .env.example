# Public browser values — safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_APP_URL=https://YOUR_VERCEL_DOMAIN

# Server-only Supabase admin key. Prefer the new secret key if the server-side
# routes use it with the Data API; keep it OUT of NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy service_role JWT can be used where Supabase Edge Functions require a JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Token encryption: 32 random bytes, base64-encoded (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Meta app configuration. Instagram Login and Threads may use separate Meta apps.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
META_GRAPH_VERSION=v27.0

# Exact URLs configured as OAuth redirect URIs in each Meta developer app
INSTAGRAM_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/oauth/instagram/callback
THREADS_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/oauth/threads/callback

# Webhook verification/signature secrets — set separately in Meta and Vercel
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
THREADS_WEBHOOK_VERIFY_TOKEN=

# Protect the Vercel Cron token refresh endpoint
CRON_SECRET=
# Server-to-server secret shared by Vercel webhook routes and the Edge Function
INTERNAL_PROCESSING_SECRET=

# Keep automatic public posting OFF until you have tested permissions, webhooks,
# token refresh and approval flow. Enable in Supabase Edge Function Secrets only.
# ENABLE_AUTO_REPLY=false
